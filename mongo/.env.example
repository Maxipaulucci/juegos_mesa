# Mongo local (Compass). No uses Atlas.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=juegosMesa

# API que usa Flutter. Distinto al puerto 27017 de Mongo.
API_PORT=27080
API_HOST=0.0.0.0

# Cambiá esto en tu PC. No lo subas a git.
JWT_SECRET=cambiá-esta-clave-local
JWT_DIAS=30

# Mail (Gmail: contraseña de aplicación, no la normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=Juegos de mesa Argentos <tu-correo@gmail.com>
