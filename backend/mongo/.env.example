# Mongo local (Compass). No uses Atlas.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=juegosMesa

# API que usa Flutter. Distinto al puerto 27017 de Mongo.
API_PORT=27080
API_HOST=0.0.0.0

# Cambiá esto en tu PC. No lo subas a git.
JWT_SECRET=cambiá-esta-clave-local
JWT_DIAS=30

# Mail con Resend (https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=Juegos de mesa Argentos <noreply@codigo.juegosdemesaargentos.com>

# Google Sign-In: Client ID(s) de Google Cloud Console (OAuth 2.0).
# Podés poner varios separados por coma (Web, Android, iOS).
# Ejemplo: 123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=
